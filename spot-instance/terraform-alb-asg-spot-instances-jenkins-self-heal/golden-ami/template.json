{
  "variables": {
  
  },
  "builders": [
    {
      "type": "amazon-ebs",
      "region": "us-east-2",
      "source_ami_filter": {
        "filters": {
          "virtualization-type": "hvm",
          "name": "al2023-ami-2023.*-kernel-*-x86_64",
          "root-device-type": "ebs"
        },
        "owners": [
          "amazon"
        ],
        "most_recent": true
      },
      "instance_type": "t3.micro",
      "spot_price": "auto",
      "ssh_username": "ec2-user",
      "ami_name": "packer-tomcat-{{timestamp}}",
	  "tags":{
		"Name": "GoldenAMI-{{timestamp}}"
	  }
    }
  ],
  "provisioners": [
    {
      "type": "shell",
      "inline": ["sudo yum install -y ansible"]
    },
    {
      "type": "ansible-local",
      "playbook_file": "playbook.yaml" ,
      "pause_before": "120s"
    }
  ]
}
