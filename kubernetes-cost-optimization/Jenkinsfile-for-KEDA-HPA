pipeline{
    agent{
         node{
             label "Slave-1"
             customWorkspace "/home/k8s-management/keda-vpa"
         }
    }
    environment{
        JAVA_HOME="/usr/lib/jvm/java-25-amazon-corretto.x86_64"
        PATH="$PATH:$JAVA_HOME/bin:/opt/apache-maven/bin:/opt/node-v16.0.0/bin:/usr/local/bin"
        ARGOCD_PASSWORD=credentials('argocd_password')
    }
    stages{
        stage("Install-KEDA-Helm"){
            steps{
                sh 'helm repo add kedacore https://kedacore.github.io/charts'
                sh 'helm repo update'
                sh 'helm upgrade --install keda kedacore/keda --namespace keda --create-namespace --version v2.21.0'
            }
        }
        stage("Install-VPA-Script"){
            steps{
                // Clone or update the kubernetes/autoscaler repository and run vpa-up.sh
                script {
                    def vpaDir = "${env.WORKSPACE}/autoscaler"
                    sh """
                        if [ -d "${vpaDir}" ]; then
                            rm -rf "${vpaDir}"
                        fi
                        git clone https://github.com/kubernetes/autoscaler.git "${vpaDir}"
                    """
                }
                // Execute the official setup script which handles cert generation, secrets, and deployment
                sh 'cd autoscaler/vertical-pod-autoscaler && ./hack/vpa-up.sh'
            }
        }
    }
}
