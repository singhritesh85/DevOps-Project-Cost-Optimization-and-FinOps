################################### Create an Activity Log Alert for Spot Evictions ########################################

resource "azurerm_monitor_activity_log_alert" "spot_eviction" {
  name                = "${var.prefix}-aks-spot-vm-evicted-alert"
  resource_group_name = azurerm_resource_group.vnetconnection_rg.name
  location            = "global"
  scopes              = [azurerm_kubernetes_cluster_node_pool.autoscale_node_pool[1].id]

  criteria {
    category = "ResourceHealth"

    resource_health {
      current = [
        "Unavailable"
      ]

      reason = [
        "PlatformInitiated"
      ]
    }
  }

#  criteria {
#    category       = "ServiceHealth"
#    operation_name = "Microsoft.Compute/virtualMachines/preempt/action"
#    status         = "Succeeded"
#  }

  action {
    action_group_id = azurerm_monitor_action_group.action_group.id
  }

  description = "Sends an email notification whenever an AKS Spot node is evicted by Azure."
}
